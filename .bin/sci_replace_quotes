#!/usr/bin/env python
# -*- coding: utf-8 -*-

import sys
import os


def replace_english_quotes_with_chinese(text):
    """
    将文本中的英文直双引号 " 按顺序替换为中文引号 “”。
    成对替换：第奇数个 -> “，第偶数个 -> ”
    """
    count = 0
    result = []

    i = 0
    while i < len(text):
        if text[i] == '"':
            count += 1
            if count % 2 == 1:
                result.append("“")  # 左引号
            else:
                result.append("”")  # 右引号
        else:
            result.append(text[i])
        i += 1

    if count % 2 == 1:
        print(
            f"⚠️ 警告：发现奇数个英文双引号（共 {count} 个），最后一个未配对。",
            file=sys.stderr,
        )

    return "".join(result)


def process_file(input_path, output_path=None):
    if not os.path.isfile(input_path):
        print(f"❌ 错误：文件不存在：{input_path}", file=sys.stderr)
        return

    # 自动设置输出文件名
    if output_path is None:
        base, ext = os.path.splitext(input_path)
        output_path = f"{base}_quoted{ext}"

    try:
        with open(input_path, "r", encoding="utf-8") as f:
            content = f.read()
    except UnicodeDecodeError:
        # 尝试用 latin-1 或其他编码（适用于某些旧 TeX 文件）
        with open(input_path, "r", encoding="latin-1") as f:
            content = f.read()

    new_content = replace_english_quotes_with_chinese(content)

    with open(output_path, "w", encoding="utf-8") as f:
        f.write(new_content)

    print(f"✅ 已处理文件：{input_path}")
    print(f"📄 输出文件：{output_path}")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("用法: python replace_quotes.py <input_file.tex> [output_file.tex]")
        sys.exit(1)

    input_file = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) > 2 else None

    process_file(input_file, output_file)
