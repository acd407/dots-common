#!/usr/bin/env python3
import re
import subprocess
import sys
import os

opt_pattern = r"""
    (--?[a-zA-Z0-9-]+)          # 选项名称
    (?:=([^ \n,"']+|"[^"]*"|'[^']*'))?  # 值
    (?:\s*,\s*(--?[a-zA-Z0-9-]+)(?:=([^ \n,"']+|"[^"]*"|'[^']*'))?)?  # 第二个选项
    (?:\s+([^\n]*))?            # 描述
"""


class CMD:
    last_output = None

    def parse(self, cmdline: list[str]) -> tuple[list[str], list[str]]:
        opts = []
        cmds = []
        output = subprocess.check_output(
            cmdline, text=True, shell=False, stderr=subprocess.STDOUT
        )
        if self.last_output:
            if self.last_output == hash(output):
                self.last_output = hash(output)
            else:
                raise ValueError("not a sub command")
        for line in output.split("\n"):
            if r := re.match(opt_pattern, line.lstrip(), re.VERBOSE):

                def groupQ(s) -> str:
                    return ' "' + r.group(s) + '"' if r.group(s) else ""

                def paraQ(s) -> str:
                    return "=<" + r.group(s) + ">" if r.group(s) else ""

                if r.group(1):
                    if r.group(3):
                        opts.append(
                            f"({r.group(1) + paraQ(2)} | {r.group(3) + paraQ(4)}){groupQ(5)}"
                        )
                    else:
                        opts.append(f"{r.group(1) + paraQ(2)}{groupQ(5)}")
            elif r := re.match(r" {2,4}([a-z]{2,})\s+[\w\[<]", line):
                if r.group(1) and r.group(1) not in cmdline:
                    cmds.append(r.group(1))
                else:
                    nonterminals = re.findall(
                        r"[^\[<]*[\[<]([a-zA-Z]+)\s?\.*[\]>]",
                        line,
                    )
                    for match_group in nonterminals:
                        match match_group.upper():
                            case "FILE":
                                opts.append("<PATH>")
                            case "DIR":
                                opts.append("<DIRECTORY>")
                            case "ADDRESS":
                                opts.append("<HOST>")

        def key(x):
            match x:
                case i if i[0] == "(":
                    return "\xff"
                case i if i[0:2] == "--":
                    return "\x00"
                case _:
                    return x

        return (list(set(cmds)), sorted(list(set(opts)), key=key))


def sub(name: list[str], cmds: list[str], opts: list[str]):
    OPT_NAME = f"<{name[-1].upper()}-OPT>"
    print(" ".join(name) + f" [{OPT_NAME}];")
    OPT_LEFT = OPT_NAME + " ::= "
    LEFT_SPACE = f"\n{' ' * (len(OPT_LEFT) - 2)}| "
    print(OPT_LEFT + LEFT_SPACE.join(opts))
    print(" " * (len(OPT_LEFT) - 2) + ";\n")
    for i in cmds:
        try:
            c, o = cmd.parse(name + [i, "--help"])
            sub(name + [i], c, o)
        except ValueError:
            print(f"W: {i} is not a sub command")


cmd = CMD()


def main():
    os.environ["LC_ALL"] = "C"
    assert len(sys.argv) == 2
    program = sys.argv[1]
    cmds, opts = cmd.parse([program, "--help"])
    sub([program], cmds, opts)


if __name__ == "__main__":
    main()
