#!/bin/python
import sys
import re


def main():
    sum = 0
    while line := sys.stdin.readline():
        matchObj = re.match(r"((\d+)\+)?(\d{2}):(\d{2})", line)
        if matchObj:
            g = matchObj.groups()
            if g[1]:
                sum += int(g[1]) * 24 * 60
            sum += int(g[2]) * 60 + int(g[3])
    print(f"{sum} minutes")
    day = sum // (24 * 60)
    hour = sum % (24 * 60)
    min = hour % 60
    hour //= 60
    print(f"{day} days, {hour} hours and {min} minutes")


if __name__ == "__main__":
    main()
